<?xml version="1.0"?>
<robot name="robot_arm_moveit">
  <!--
    Standalone arm URDF for MoveIt.
    Geometry, joint names, and joint limits are aligned with:
    - src/robot_description/urdf/model/robot.arm.xacro
    - src/robot_arm/robot_arm/kinematics.py
  -->

  <material name="dark_grey">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!-- IK origin: bottom of the arm base column -->
  <link name="base_link"/>

  <joint name="arm_base_joint" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="10" velocity="3.14"/>
  </joint>

  <link name="arm_link0">
    <visual>
      <origin xyz="0 0 0.0169324" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.0338648"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0169324" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.0338648"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0169324" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="5.1170616976e-05" ixy="0" ixz="0" iyy="5.1170616976e-05" iyz="0" izz="4.5e-05"/>
    </inertial>
  </link>

  <joint name="arm_shoulder_joint" type="revolute">
    <parent link="arm_link0"/>
    <child link="arm_link1"/>
    <origin xyz="0 0 0.0338648" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5707963267948966" upper="3.141592653589793" effort="10" velocity="3.14"/>
  </joint>

  <link name="arm_link1">
    <visual>
      <origin xyz="0 0 0.064708" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.129416"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.064708" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.129416"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.064708" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0005882833685333334" ixy="0" ixz="0" iyy="0.0005882833685333334" iyz="0" izz="6e-05"/>
    </inertial>
  </link>

  <joint name="arm_elbow_joint" type="revolute">
    <parent link="arm_link1"/>
    <child link="arm_link2"/>
    <origin xyz="0 0 0.129416" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="3.141592653589793" effort="10" velocity="3.14"/>
  </joint>

  <link name="arm_link2">
    <visual>
      <origin xyz="0 0 0.064722" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.129444"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.064722" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.129444"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.064722" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0004413937284" ixy="0" ixz="0" iyy="0.0004413937284" iyz="0" izz="4.5e-05"/>
    </inertial>
  </link>

  <joint name="arm_wrist_joint" type="revolute">
    <parent link="arm_link2"/>
    <child link="arm_link3"/>
    <origin xyz="0 0 0.129444" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="3.141592653589793" effort="10" velocity="3.14"/>
  </joint>

  <link name="arm_link3">
    <visual>
      <origin xyz="0 0 0.0284662" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.0569324"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0284662" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.0569324"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0284662" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="3.4510818081333334e-05" ixy="0" ixz="0" iyy="3.4510818081333334e-05" iyz="0" izz="1.5e-05"/>
    </inertial>
  </link>

  <joint name="arm_tool_rotate_joint" type="revolute">
    <parent link="arm_link3"/>
    <child link="arm_link4"/>
    <origin xyz="0 0 0.0569324" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="10" velocity="3.14"/>
  </joint>

  <link name="arm_link4">
    <visual>
      <origin xyz="0 0 0.0284662" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.0569324"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0284662" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.0569324"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0284662" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="3.4510818081333334e-05" ixy="0" ixz="0" iyy="3.4510818081333334e-05" iyz="0" izz="1.5e-05"/>
    </inertial>
  </link>

  <joint name="virtual_tool_roll_joint" type="revolute">
    <parent link="arm_link4"/>
    <child link="tool_roll_link"/>
    <origin xyz="0 0 0.0569324" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="1" velocity="3.14"/>
  </joint>

  <link name="tool_roll_link"/>

  <joint name="virtual_tool_pitch_joint" type="revolute">
    <parent link="tool_roll_link"/>
    <child link="tool_pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="1" velocity="3.14"/>
  </joint>

  <link name="tool_pitch_link"/>

  <joint name="virtual_tool_yaw_joint" type="revolute">
    <parent link="tool_pitch_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="1" velocity="3.14"/>
  </joint>

  <link name="tool0"/>

  <joint name="camera_bracket_joint" type="fixed">
    <parent link="arm_link4"/>
    <child link="camera_bracket"/>
    <origin xyz="-0.0225 0 0" rpy="0 -1.5707963267948966 0"/>
  </joint>

  <link name="camera_bracket">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.04 0.015"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.04 0.015"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="3.041666666666667e-06" ixy="0" ixz="0" iyy="1.0416666666666667e-06" iyz="0" izz="3.3333333333333337e-06"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="camera_bracket"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.025"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="3.1250000000000006e-06" ixy="0" ixz="0" iyy="3.1250000000000006e-06" iyz="0" izz="3.1250000000000006e-06"/>
    </inertial>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.570795 0 -1.570795"/>
  </joint>

  <link name="camera_optical_link"/>
</robot>
