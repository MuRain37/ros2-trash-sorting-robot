<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="wheel.joints.xacro"/>

    <xacro:macro name="robot_custom_ros2_control">
        <ros2_control name="RobotCustomSystem" type="system">
            <hardware>
                <plugin>robot_description/DiffRobotHardware</plugin>
            </hardware>
            <xacro:wheel_joints/>
        </ros2_control>
    </xacro:macro>
</robot>