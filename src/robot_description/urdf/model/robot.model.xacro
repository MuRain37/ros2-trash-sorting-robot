<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========== 公共属性 ========== -->
  <!-- 机器人常量 -->
  <xacro:property name="PI" value="3.1415926535897931"/>

  <!-- 底盘属性 -->
  <xacro:property name="chassis_length" value="0.300"/>
  <xacro:property name="chassis_width" value="0.200"/>
  <xacro:property name="chassis_height" value="0.050"/>
  <xacro:property name="chassis_mass" value="5.0"/>

  <!-- 轮子属性 -->
  <xacro:property name="wheel_radius" value="0.030"/>
  <xacro:property name="wheel_thickness" value="0.025"/>
  <xacro:property name="wheel_mass" value="0.5"/>

  <!-- 安装位置偏移 -->
  <xacro:property name="wheel_z_offset" value="0.030"/>
  <xacro:property name="wheel_x_offset" value="0.100"/>

  <!-- ========== 底盘 ========== -->
  <xacro:include filename="robot.chassis.xacro"/>

  <!-- ========== 轮子 ========== -->
  <xacro:include filename="robot.wheels.xacro"/>

  <!-- ========== 激光雷达 ========== -->
  <xacro:include filename="robot.lidar.xacro"/>

  <!-- ========== 机械臂 ========== -->
  <xacro:include filename="robot.arm.xacro"/>

  <!-- ========== 侧边桶子 ========== -->
  <xacro:include filename="robot.barrel.xacro"/>
  <xacro:barrel name="left_barrel" y_sign="1"/>
  <xacro:barrel name="right_barrel" y_sign="-1"/>

  <gazebo reference="left_barrel">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="right_barrel">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ========== 深度相机（挂在机械臂末端 arm_link4 上） ========== -->
  <xacro:include filename="robot.camera.xacro"/>

</robot>
