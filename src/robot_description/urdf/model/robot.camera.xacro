<?xml version="1.0"?>
<robot xmlns:xacro="http://www.wiki.ros.org/xacro">

  <!-- ========== 相机支架属性 ========== -->
  <xacro:property name="camera_bracket_length" value="0.020"/>
  <xacro:property name="camera_bracket_width" value="0.0042"/>
  <xacro:property name="camera_bracket_height" value="0.0482060266977644"/>
  <xacro:property name="camera_bracket_mount_length" value="0.0357060266977644"/>
  <xacro:property name="camera_bracket_origin_y" value="0.0116030133488822"/>
  <xacro:property name="camera_bracket_mass" value="0.02"/>

  <!-- ========== 相机属性 ========== -->
  <xacro:property name="camera_box_length" value="0.025"/>
  <xacro:property name="camera_box_width" value="0.090"/>
  <xacro:property name="camera_box_height" value="0.025"/>
  <xacro:property name="camera_mass" value="0.03"/>

  <!-- ========== 相机支架链接 ========== -->
  <link name="camera_bracket">
    <visual>
      <origin xyz="0 ${camera_bracket_origin_y} 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_bracket_length} ${camera_bracket_height} ${camera_bracket_width}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 ${camera_bracket_origin_y} 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_bracket_length} ${camera_bracket_height} ${camera_bracket_width}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 ${camera_bracket_origin_y} 0" rpy="0 0 0"/>
      <mass value="${camera_bracket_mass}"/>
      <inertia ixx="${camera_bracket_mass / 12.0 * (camera_bracket_height**2 + camera_bracket_width**2)}"
               ixy="0" ixz="0"
               iyy="${camera_bracket_mass / 12.0 * (camera_bracket_length**2 + camera_bracket_width**2)}"
               iyz="0"
               izz="${camera_bracket_mass / 12.0 * (camera_bracket_length**2 + camera_bracket_height**2)}"/>
    </inertial>
  </link>

  <joint name="camera_bracket_joint" type="fixed">
    <parent link="arm_link3"/>
    <child link="camera_bracket"/>
    <origin xyz="-0.0507060266977644 0 0.0505384841187764" rpy="0 0 ${-PI/2}"/>
  </joint>

  <!-- ========== 相机链接 ========== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 -0.032 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_box_length} ${camera_box_width} ${camera_box_height}"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.032 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_box_length} ${camera_box_width} ${camera_box_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.032 0" rpy="0 0 0"/>
      <mass value="${camera_mass}"/>
      <inertia ixx="${camera_mass / 12.0 * (camera_box_width**2 + camera_box_height**2)}"
               ixy="0" ixz="0"
               iyy="${camera_mass / 12.0 * (camera_box_length**2 + camera_box_height**2)}"
               iyz="0"
               izz="${camera_mass / 12.0 * (camera_box_length**2 + camera_box_width**2)}"/>
    </inertial>
  </link>

  <!-- 相机与支架的固定关节-->
  <joint name="camera_joint" type="fixed">
    <parent link="camera_bracket"/>
    <child link="camera_link"/>
    <origin xyz="-0.032 0 0.014475" rpy="${PI} ${-PI/2} ${-PI/2}"/>
  </joint>

  <!-- ========== 相机光学坐标框架 (ROS 相机惯例) ========== -->
  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.570795 0 -1.570795"/>
  </joint>

  <!-- ========== Gazebo 材质 ========== -->
  <gazebo reference="camera_bracket">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/Grey</material>
  </gazebo>

</robot>
