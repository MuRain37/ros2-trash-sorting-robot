<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========== 机械臂属性 ========== -->
  <xacro:property name="arm_l1" value="0.0338648"/>
  <xacro:property name="arm_l2" value="0.129416"/>
  <xacro:property name="arm_l3" value="0.129444"/>
  <xacro:property name="arm_l4" value="0.0569324"/>
  <xacro:property name="arm_l5" value="0.0569324"/>

  <xacro:property name="arm_w" value="0.030"/>

  <xacro:property name="gripper_base_length" value="${arm_w}"/>
  <xacro:property name="gripper_base_width" value="0.070"/>
  <xacro:property name="gripper_base_height" value="0.018"/>
  <xacro:property name="gripper_finger_length" value="${arm_l5 - gripper_base_height}"/>
  <xacro:property name="gripper_finger_width" value="${arm_w}"/>
  <xacro:property name="gripper_finger_thickness" value="0.010"/>
  <xacro:property name="gripper_finger_y_offset" value="0.026"/>

  <xacro:property name="arm_m0" value="0.3"/>
  <xacro:property name="arm_m1" value="0.4"/>
  <xacro:property name="arm_m2" value="0.3"/>
  <xacro:property name="arm_m3" value="0.1"/>
  <xacro:property name="arm_m4" value="0.1"/>
  <xacro:property name="gripper_base_mass" value="${arm_m4 * 0.70}"/>
  <xacro:property name="gripper_finger_mass" value="${arm_m4 * 0.15}"/>

  <xacro:property name="arm_origin_x" value="${chassis_length/2 - 0.05}"/>
  <xacro:property name="arm_origin_y" value="0.0"/>
  <xacro:property name="arm_origin_z" value="${chassis_height/2}"/>

  <!-- ========== 长方体惯性宏 ========== -->
  <xacro:macro name="box_inertia" params="mass w h">
    <inertia ixx="${mass/12.0 * (w*w + h*h)}" ixy="0" ixz="0"
             iyy="${mass/12.0 * (w*w + h*h)}" iyz="0"
             izz="${mass/6.0 * w*w}"/>
  </xacro:macro>

  <xacro:macro name="box_inertia_xyz" params="mass x y z">
    <inertia ixx="${mass/12.0 * (y*y + z*z)}" ixy="0" ixz="0"
             iyy="${mass/12.0 * (x*x + z*z)}" iyz="0"
             izz="${mass/12.0 * (x*x + y*y)}"/>
  </xacro:macro>

  <!-- ========== 连杆宏 ========== -->
  <xacro:macro name="arm_link" params="name length mass color">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_w} ${arm_w} ${length}"/>
        </geometry>
        <material name="${color}">
          <color rgba="${color} 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_w} ${arm_w} ${length}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <xacro:box_inertia mass="${mass}" w="${arm_w}" h="${length}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="gripper_finger" params="name y_sign">
    <joint name="${name}_joint" type="fixed">
      <parent link="arm_link4"/>
      <child link="${name}"/>
      <origin xyz="0 ${y_sign * gripper_finger_y_offset} ${gripper_base_height}" rpy="0 0 0"/>
    </joint>

    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${gripper_finger_length/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${gripper_finger_width} ${gripper_finger_thickness} ${gripper_finger_length}"/>
        </geometry>
        <material name="gripper_finger_black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${gripper_finger_length/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${gripper_finger_width} ${gripper_finger_thickness} ${gripper_finger_length}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${gripper_finger_length/2}" rpy="0 0 0"/>
        <mass value="${gripper_finger_mass}"/>
        <xacro:box_inertia_xyz mass="${gripper_finger_mass}" x="${gripper_finger_width}" y="${gripper_finger_thickness}" z="${gripper_finger_length}"/>
      </inertial>
    </link>
  </xacro:macro>

  <joint name="arm_base_joint" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link0"/>
    <origin xyz="${arm_origin_x} ${arm_origin_y} ${arm_origin_z}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-PI}" upper="${PI}" effort="10" velocity="3.14"/>
  </joint>

  <xacro:arm_link name="arm_link0" length="${arm_l1}" mass="${arm_m0}" color="0.1 0.1 0.1"/>
  <gazebo reference="arm_link0">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <joint name="arm_shoulder_joint" type="revolute">
    <parent link="arm_link0"/>
    <child link="arm_link1"/>
    <origin xyz="0 0 ${arm_l1}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI/2}" upper="${PI}" effort="10" velocity="3.14"/>
  </joint>

  <xacro:arm_link name="arm_link1" length="${arm_l2}" mass="${arm_m1}" color="0.5 0.5 0.5"/>
  <gazebo reference="arm_link1">
    <material>Gazebo/Grey</material>
  </gazebo>

  <joint name="arm_elbow_joint" type="revolute">
    <parent link="arm_link1"/>
    <child link="arm_link2"/>
    <origin xyz="0 0 ${arm_l2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="${PI}" effort="10" velocity="3.14"/>
  </joint>

  <xacro:arm_link name="arm_link2" length="${arm_l3}" mass="${arm_m2}" color="0.1 0.1 0.1"/>
  <gazebo reference="arm_link2">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <joint name="arm_wrist_joint" type="revolute">
    <parent link="arm_link2"/>
    <child link="arm_link3"/>
    <origin xyz="0 0 ${arm_l3}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="${PI}" effort="10" velocity="3.14"/>
  </joint>

  <xacro:arm_link name="arm_link3" length="${arm_l4}" mass="${arm_m3}" color="0.5 0.5 0.5"/>
  <gazebo reference="arm_link3">
    <material>Gazebo/Grey</material>
  </gazebo>

  <joint name="arm_tool_rotate_joint" type="revolute">
    <parent link="arm_link3"/>
    <child link="arm_link4"/>
    <origin xyz="0 0 ${arm_l4}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-PI}" upper="${PI}" effort="10" velocity="3.14"/>
  </joint>

  <link name="arm_link4">
    <visual>
      <origin xyz="0 0 ${gripper_base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${gripper_base_length} ${gripper_base_width} ${gripper_base_height}"/>
      </geometry>
      <material name="gripper_base_grey">
        <color rgba="0.45 0.45 0.45 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${gripper_base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${gripper_base_length} ${gripper_base_width} ${gripper_base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${gripper_base_height/2}" rpy="0 0 0"/>
      <mass value="${gripper_base_mass}"/>
      <xacro:box_inertia_xyz mass="${gripper_base_mass}" x="${gripper_base_length}" y="${gripper_base_width}" z="${gripper_base_height}"/>
    </inertial>
  </link>
  <gazebo reference="arm_link4">
    <material>Gazebo/Grey</material>
  </gazebo>

  <xacro:gripper_finger name="left_gripper_finger" y_sign="1"/>
  <xacro:gripper_finger name="right_gripper_finger" y_sign="-1"/>
  <gazebo reference="left_gripper_finger">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="right_gripper_finger">
    <material>Gazebo/Black</material>
  </gazebo>

  <joint name="virtual_tool_roll_joint" type="revolute">
    <parent link="arm_link4"/>
    <child link="tool_roll_link"/>
    <origin xyz="0 0 ${arm_l5}" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-PI}" upper="${PI}" effort="1" velocity="3.14"/>
  </joint>

  <link name="tool_roll_link"/>

  <joint name="virtual_tool_pitch_joint" type="revolute">
    <parent link="tool_roll_link"/>
    <child link="tool_pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI}" upper="${PI}" effort="1" velocity="3.14"/>
  </joint>

  <link name="tool_pitch_link"/>

  <joint name="virtual_tool_yaw_joint" type="revolute">
    <parent link="tool_pitch_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-PI}" upper="${PI}" effort="1" velocity="3.14"/>
  </joint>

  <link name="tool0"/>

</robot>
