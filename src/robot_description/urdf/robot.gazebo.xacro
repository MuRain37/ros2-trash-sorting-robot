<?xml version="1.0"?>
<robot name="four_wheel_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 共享模型定义 -->
  <xacro:include filename="$(find robot_description)/urdf/model/robot.model.xacro" />

  <!-- ros2_control hardware interface -->
  <xacro:include filename="$(find robot_description)/urdf/control/gazebo.control.xacro" />
  <xacro:robot_ros2_control />

  <!-- 激光雷达 Gazebo 插件 -->
  <xacro:include filename="$(find robot_description)/urdf/plugin/robot.lidar.gazebo.xacro" />
  <xacro:lidar_gazebo_plugin />

  <!-- IMU Gazebo 插件 -->
  <xacro:include filename="$(find robot_description)/urdf/plugin/robot.imu.gazebo.xacro" />
  <xacro:imu_gazebo_plugin />

  <!-- 深度相机 Gazebo 插件 -->
  <xacro:include filename="$(find robot_description)/urdf/plugin/robot.camera.gazebo.xacro" />
  <xacro:camera_gazebo_plugin />

</robot>