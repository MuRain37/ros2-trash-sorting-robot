<?xml version="1.0"?>
<robot xmlns:xacro="http://www.wiki.ros.org/xacro">

  <xacro:macro name="camera_gazebo_plugin">
    <gazebo reference="camera_link">
      <sensor type="depth" name="camera_sensor">
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.5009831567</horizontal_fov>
          <image>
            <width>800</width>
            <height>600</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>8.0</far>
          </clip>
        </camera>
        <plugin name="depth_camera" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/camera</namespace>
            <remapping>image_raw:=image_raw</remapping>
            <remapping>depth/image_raw:=depth/image_raw</remapping>
            <remapping>depth/points:=depth/points</remapping>
            <remapping>camera_info:=camera_info</remapping>
            <remapping>depth/camera_info:=depth/camera_info</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_optical_link</frame_name>
          <hack_baseline>0.07</hack_baseline>
          <min_depth>0.001</min_depth>
          <max_depth>8.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
