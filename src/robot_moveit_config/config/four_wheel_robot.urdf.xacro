<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="four_wheel_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import four_wheel_robot urdf file -->
    <xacro:include filename="$(find robot_description)/urdf/robot.custom.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="four_wheel_robot.ros2_control.xacro" />


    <xacro:four_wheel_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
